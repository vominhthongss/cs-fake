; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/enabled=true
general/android/app_id="ca-app-pub-3940256099942544~3347511713"
general/android/enable_r8_optimization=false
general/android/disable_initialization_optimization=false
general/android/disable_ad_loading_optimization=false
general/ios/enabled=true
general/ios/app_id="ca-app-pub-3940256099942544~1458002511"
mediation/applovin=false
mediation/bidmachine=false
mediation/chartboost=false
mediation/dtexchange=false
mediation/imobile=false
mediation/inmobi=false
mediation/ironsource=false
mediation/line=false
mediation/maio=false
mediation/meta=false
mediation/mintegral=false
mediation/moloco=false
mediation/mytarget=false
mediation/pangle=false
mediation/pubmatic=false
mediation/unity_ads=false
mediation/vungle=false

[app_info]

short_name="CS-PROTOCOL"
developer="vominhthongss"
website="https://vominhthongss.github.io"
privacy_policy_path="/cs-protocol/policy.html"
support_email="contact@vominhthongss.github.io"

[application]

config/name="CS-PROTOCOL // Tactical Bot FPS"
config/description="3D CS:GO-inspired tactical FPS with full arsenal physics and smart utility-AI bots."
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.06, 0.05, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/icons/logo_splash.png"
config/icon="res://assets/icons/icon_1024.png"
boot_splash/minimum_display_time=800

[autoload]

TacticalAudio="*res://scripts/audio/TacticalAudio.gd"
AdManager="*res://scripts/autoload/ad_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/ui_font.ttf"

