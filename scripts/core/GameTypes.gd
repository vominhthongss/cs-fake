static func create_weapon_instance(weapon_id: String) -> Dictionary:
	var spec: Dictionary = WEAPONS[weapon_id]
	return {
		"id": weapon_id,
		"ammo_in_mag": int(spec["magazine_size"]),
		"reserve_ammo": int(spec["reserve_max"]),
	}

static func difficulty_to_string(diff: BotDifficulty) -> String:
	match diff:
		BotDifficulty.RECRUIT:
			return "RECRUIT"
		BotDifficulty.TACTICAL:
			return "TACTICAL"
		BotDifficulty.ELITE:
			return "ELITE"
	return "TACTICAL"
